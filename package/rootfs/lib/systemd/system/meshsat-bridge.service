[Unit]
Description=MeshSat Bridge (mesh and satellite gateway) on this device
Documentation=https://github.com/meshsat/meshsat-linux/blob/main/docs/INSTALL.md
After=network-online.target meshsat-hardware.service meshtasticd.service
Wants=network-online.target meshsat-hardware.service meshtasticd.service

[Service]
Type=simple
User=meshsat
Group=meshsat
SupplementaryGroups=dialout
EnvironmentFile=/etc/meshsat/bridge.env
# What meshsat-hardware found: the mesh port is the cover's daemon, or a node over Bluetooth.
EnvironmentFile=-/run/meshsat/hardware.env
StateDirectory=meshsat
WorkingDirectory=/var/lib/meshsat
ExecStart=/usr/bin/meshsat
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
