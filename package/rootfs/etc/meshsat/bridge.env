# The MeshSat Bridge on this device (read by meshsat-bridge.service).
# After a change: sudo systemctl restart meshsat-bridge

# Standalone: the Bridge talks to its devices itself, no HAL.
MESHSAT_MODE=direct
MESHSAT_PORT=6050
MESHSAT_DB_PATH=/var/lib/meshsat/meshsat.db

# The mesh radio is the LoRa back cover, driven by meshtasticd on this phone.
MESHSAT_MESHTASTIC_PORT=tcp://127.0.0.1:4403

# No Reticulum TCP listener on a phone.
MESHSAT_TCP_LISTEN=none

# The phone's own cellular modem (Quectel EG25/EC25 on a PinePhone) is ModemManager's;
# the Bridge must not probe its four ports. A RockBLOCK on USB-C shows up as a further ttyUSB.
MESHSAT_SERIAL_SKIP_PORTS=/dev/ttyUSB0,/dev/ttyUSB1,/dev/ttyUSB2,/dev/ttyUSB3

# SMS goes through ModemManager (the phone's SIM), never through the modem's serial ports.
# The package's polkit rule lets the meshsat user use it. A SIM PIN: MESHSAT_SIM_PIN=1234
MESHSAT_CELLULAR_PORT=modemmanager

# Iridium: a RockBLOCK 9603 on USB-C is found by itself; name its port to pin it.
# MESHSAT_IRIDIUM_PORT=/dev/ttyUSB4

# The MeshSat Hub: an API key from your tenant's Fleet page at https://hub.meshsat.net.
# Empty = no Hub link; the mesh still works.
HUB_API_KEY=
