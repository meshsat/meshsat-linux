// The MeshSat Bridge runs as the system user "meshsat" with no login session, and sends and
// receives SMS through ModemManager, whose D-Bus methods polkit protects. This lets that user,
// and nobody else, use the modem's messaging, control and device-control actions.
polkit.addRule(function(action, subject) {
    if (action.id.indexOf("org.freedesktop.ModemManager1.") === 0 && subject.user === "meshsat") {
        return polkit.Result.YES;
    }
});

// The person at the screen may ask the device to look for its node again (the LoRa back cover
// put on or taken off): that is one unit, meshsat-hardware.service, started and nothing else.
polkit.addRule(function(action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "meshsat-hardware.service" &&
        action.lookup("verb") === "start" &&
        subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
