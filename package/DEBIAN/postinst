#!/bin/sh
# postinst of the meshsat package: what packaging/install.sh of meshsat-lora-backplate does
# for a source install, done by the package. Every step checks before it changes.
set -e

case "$1" in
    configure)
        # The node daemon is in the arm64 package only (the PinePhone's LoRa back cover); the
        # amd64 package is the Bridge and the app, with a node over Bluetooth.
        NODE=0; [ -x /usr/bin/meshtasticd ] && NODE=1

        # Users: the daemon on the I2C bus, the Bridge on the USB serial ports.
        getent passwd meshsat >/dev/null || adduser --system --group --home /var/lib/meshsat --no-create-home --shell /usr/sbin/nologin meshsat
        adduser meshsat dialout >/dev/null 2>&1 || true
        install -d -o meshsat -g meshsat -m 0750 /var/lib/meshsat
        if [ "$NODE" = 1 ]; then
        getent group i2c >/dev/null || addgroup --system i2c
        getent passwd meshtasticd >/dev/null || adduser --system --group --home /var/lib/meshtasticd --no-create-home --shell /usr/sbin/nologin meshtasticd
        adduser meshtasticd i2c >/dev/null 2>&1 || true
        install -d -o meshtasticd -g meshtasticd -m 0750 /var/lib/meshtasticd
        chown -R meshtasticd:meshtasticd /usr/share/meshtasticd

        # The bus: the module now (and at boot through modules-load.d), the permissions,
        # the keyboard case's drivers out of the way.
        modprobe i2c-dev 2>/dev/null || true
        udevadm control --reload 2>/dev/null || true
        udevadm trigger --subsystem-match=i2c-dev 2>/dev/null || true
        for m in pinephone_keyboard ip5xxx_power; do
            if lsmod | grep -q "^$m "; then modprobe -r "$m" 2>/dev/null || true; fi
        done

        # The node's log is the daemon's journal: the people who use this phone read it in the
        # app (Setup > Advanced > Node log), which takes effect at their next login.
        if getent group systemd-journal >/dev/null; then
            getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 && $7 !~ /(nologin|false)$/ {print $1}' | while read -r person; do
                adduser "$person" systemd-journal >/dev/null 2>&1 || true
            done
        fi

        # A certificate for the daemon's web server: it cannot make its own on Linux.
        if [ ! -f /etc/meshtasticd/ssl/certificate.pem ]; then
            install -d -o meshtasticd -g meshtasticd -m 0750 /etc/meshtasticd/ssl
            openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -subj "/CN=meshtastic.local/O=MeshSat" \
                -keyout /etc/meshtasticd/ssl/private_key.pem -out /etc/meshtasticd/ssl/certificate.pem 2>/dev/null
            chown meshtasticd:meshtasticd /etc/meshtasticd/ssl/private_key.pem /etc/meshtasticd/ssl/certificate.pem
            chmod 0600 /etc/meshtasticd/ssl/private_key.pem
        fi
        fi

        # A node that was run by hand on this phone keeps its identity (keys, channels, node
        # database): the first such prefs directory found is copied, once.
        if [ "$NODE" = 1 ] && [ ! -d /var/lib/meshtasticd/.portduino/default/prefs ]; then
            for home in "$( [ -n "${SUDO_USER:-}" ] && getent passwd "$SUDO_USER" | cut -d: -f6 )" /home/*; do
                if [ -n "$home" ] && [ -d "$home/.portduino/default/prefs" ]; then
                    install -d -o meshtasticd -g meshtasticd /var/lib/meshtasticd/.portduino/default
                    cp -a "$home/.portduino/default/prefs" /var/lib/meshtasticd/.portduino/default/prefs
                    chown -R meshtasticd:meshtasticd /var/lib/meshtasticd/.portduino
                    echo "meshsat: node identity taken from $home/.portduino/default/prefs"
                    break
                fi
            done
        fi
        # A bench daemon started by hand gives way to the service.
        for home in /home/*; do
            if [ -f "$home/pinedio/daemon/run.sh" ]; then touch "$home/pinedio/daemon/stop" 2>/dev/null || true; fi
        done
        if pgrep -x meshtasticd >/dev/null 2>&1 && ! systemctl is-active --quiet meshtasticd 2>/dev/null; then
            pkill -TERM -x meshtasticd || true
            sleep 2
        fi

        # A bridge.env kept from an earlier version (dpkg keeps an edited conffile) learns the
        # settings later versions added, each once.
        if [ -f /etc/meshsat/bridge.env ] && ! grep -q '^MESHSAT_CELLULAR_PORT=' /etc/meshsat/bridge.env; then
            printf '\n# SMS through ModemManager (the phone'"'"'s SIM); added by the meshsat package.\nMESHSAT_CELLULAR_PORT=modemmanager\n' >> /etc/meshsat/bridge.env
        fi

        # The apps' typeface.
        if command -v fc-cache >/dev/null 2>&1; then fc-cache -f /usr/share/fonts/truetype/meshsat >/dev/null 2>&1 || true; fi

        # MeshSat's tile and lock-screen widget for Phosh: Phosh reads its plugin directory's
        # module cache when it starts, so they are there from the next start of the shell.
        for q in /usr/lib/*/glib-2.0/gio-querymodules; do
            [ -x "$q" ] || continue
            d=$(dirname "$(dirname "$q")")/phosh/plugins
            if [ -d "$d" ]; then "$q" "$d" 2>/dev/null || true; fi
        done

        # The app in the app grid.
        if command -v gtk-update-icon-cache >/dev/null 2>&1; then gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true; fi
        if command -v update-desktop-database >/dev/null 2>&1; then update-desktop-database -q 2>/dev/null || true; fi

        # The services, now and at boot. meshsat-hardware decides first whether this device has
        # the LoRa back cover (then the daemon and the watchdog run) or adopts a node over
        # Bluetooth (then they stay off); the Bridge follows what it found.
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload
            if [ "$NODE" = 1 ]; then
                systemctl enable meshsat-hardware.service meshtasticd.service meshsat-radio-watch.timer meshsat-bridge.service >/dev/null 2>&1 || true
                systemctl stop meshsat-radio-watch.timer meshtasticd.service 2>/dev/null || true
            else
                systemctl enable meshsat-hardware.service meshsat-bridge.service >/dev/null 2>&1 || true
            fi
            systemctl start meshsat-hardware.service || true
            systemctl restart meshsat-bridge.service || true
            # MeshSat outside its window (notifications, the satellite signal): a user service
            # of every graphical session from now on, and of the sessions that are running.
            systemctl --global enable meshsat-notify.service >/dev/null 2>&1 || true
            for uid in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $1}'); do
                [ "$uid" -ge 1000 ] 2>/dev/null || continue
                user=$(id -nu "$uid" 2>/dev/null) || continue
                systemctl --user --machine="$user@.host" daemon-reload >/dev/null 2>&1 || true
                systemctl --user --machine="$user@.host" restart meshsat-notify.service >/dev/null 2>&1 || true
            done
        fi
        # No verdict yet (a container, or meshsat-hardware not run): sed exits 2 on a missing
        # file, which under set -e ended the script before its last words (pipeline 56799).
        node=$(sed -n 's/^MESHSAT_NODE=//p' /run/meshsat/hardware.env 2>/dev/null || true)
        if [ "$node" = cover ]; then
            echo "meshsat: the LoRa back cover is this device's node; the node and the Bridge are starting. The MeshSat app is in the app grid (or run meshsat-app)."
        else
            echo "meshsat: no LoRa back cover on this device; the Bridge is starting in Bluetooth mode. Open the MeshSat app (in the app grid, or meshsat-app) and connect your node under Setup > Node."
        fi
        if [ "$NODE" = 1 ] && [ ! -d /var/lib/meshtasticd/.portduino/default/prefs ]; then
            echo "meshsat: a new node: give it its channels with  cat channel-url.txt | meshsat-node-channels --owner <name> --short <ABCD> --role CLIENT_MUTE"
        fi
        ;;
esac

exit 0
